# ─────────────────────────────────────────────────────────────
# BR Kitchen Hub — environment variables
# Copy to `.dev.vars` for local Cloudflare/OpenNext dev, and set the
# same keys as encrypted secrets in production via `wrangler secret put`.
# NEVER commit real secrets. Public (NEXT_PUBLIC_*) values are safe to expose.
# ─────────────────────────────────────────────────────────────

# --- Auth ---
# Long random string used to sign session + OTP JWTs (jose).
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (Resend) — used from Phase 3 onward ---
RESEND_API_KEY=
RESEND_FROM="BR Kitchen Hub <no-reply@example.com>"

# --- Anti-spam (Cloudflare Turnstile) — used from Phase 3 onward ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Payments (Stripe) — used from Phase 10 onward ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Google Calendar (OPTIONAL) — used from Phase 3 onward ---
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# --- Internal cron authentication ---
ADMIN_API_KEY=
